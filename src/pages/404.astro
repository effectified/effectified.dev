	<section class="room closing">
		<div class="wrap">
			<span class="label">// 404 · <span class="fail">! NotFound</span></span>
			<h2 style="margin-top: 22px">Nothing here. <span class="dim">Yet.</span></h2>
			<div class="hero-actions">
				<a class="btn btn-solid" href="/">Back to effectified</a>
			</div>
		</div>
	</section>
</Base>
